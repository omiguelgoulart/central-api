generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ENUMS

enum AdminRole {
  SUPER_ADMIN
  OPERACIONAL
  PORTARIA
}

enum StatusSocio {
  ATIVO
  INADIMPLENTE
  CANCELADO
}

enum Periodicidade {
  MENSAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

enum MetodoPagamento {
  BOLETO
  CARTAO_CREDITO
  CARTAO_DEBITO
  DINHEIRO
  PIX
}

enum StatusAssinatura {
  ATIVA
  CANCELADA
  SUSPENSA
  EXPIRADA
}

enum StatusFatura {
  ABERTA
  PAGA
  ATRASADA
  CANCELADA
}

enum StatusPagamentoSocio {
  PENDENTE
  PAGO
  ATRASADO
  CANCELADO
}

enum StatusPagamentoIngresso {
  AGUARDANDO
  APROVADO
  RECUSADO
  ESTORNADO
}

enum StatusPedido {
  PENDENTE
  PAGO
  CANCELADO
  EXPIRADO
  ESTORNADO
}

enum StatusIngresso {
  VALIDO
  USADO
  CANCELADO
  EXPIRADO
  ESTORNADO
}

enum TipoLote {
  INTEIRA
  MEIA
  CORTESIA
  PROMO
}

enum TipoSetor {
  ARQUIBANCADA
  CADEIRA
  CAMAROTE
  VISITANTE
  ACESSIVEL
}

// ADMIN

model Admin {
  id           String     @id @default(uuid())
  nome         String
  email        String     @unique
  senha        String
  role         AdminRole  @default(OPERACIONAL)
  ativo        Boolean    @default(true)
  criadoEm     DateTime   @default(now())
  atualizadoEm DateTime   @updatedAt

  jogosCriados     Jogo[] @relation("JogoCriadoPor")
  jogosAtualizados Jogo[] @relation("JogoAtualizadoPor")

  @@map("admins")
}

// TORCEDOR

model Torcedor {
  id                 String      @id @default(uuid())
  matricula          String      @unique
  nome               String
  email              String      @unique
  senha              String
  telefone           String?
  cpf                String?     @unique
  dataNascimento     DateTime?
  genero             String?
  fotoUrl            String?
  enderecoLogradouro String?
  enderecoNumero     String?
  enderecoBairro     String?
  enderecoCidade     String?
  enderecoUF         String?
  enderecoCEP        String?

  statusSocio       StatusSocio?
  inadimplenteDesde DateTime?

  aceitaTermosEm    DateTime?
  aceitaMarketing   Boolean?  @default(false)
  aceitaMarketingEm DateTime?
  origemCadastro    String?

  documentoFrenteUrl String?
  documentoVersoUrl  String?
  gatewayClienteId   String?
  faceId             String?

  emailVerificado    Boolean   @default(false)
  emailToken         String?   @unique
  emailTokenExpiraEm DateTime?
  senhaToken         String?   @unique
  senhaTokenExpiraEm DateTime?

  assinaturas      Assinatura[]
  pagamentosSocio  PagamentoSocio[]
  pedidos          Pedido[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([statusSocio])
  @@index([cpf])
  @@index([email])
  @@map("torcedores")
}

// PLANOS E ASSINATURAS (sócio-torcedor)

model Plano {
  id            String        @id @default(uuid())
  nome          String        @unique
  descricao     String?
  valor         Decimal       @db.Decimal(10, 2)
  periodicidade Periodicidade
  isFeatured    Boolean       @default(false)
  badgeLabel    String?
  ordem         Int           @default(0)

  assinaturas Assinatura[]
  beneficios  Beneficio[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("planos")
}

model Beneficio {
  id        String  @id @default(uuid())
  slug      String  @unique
  titulo    String
  descricao String?
  icone     String?
  ativo     Boolean @default(true)
  ordem     Int     @default(0)
  destaque  Boolean @default(false)
  observacao String?

  planoId String
  plano   Plano  @relation(fields: [planoId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([planoId])
  @@map("beneficios")
}

model Assinatura {
  id         String           @id @default(uuid())
  torcedorId String
  planoId    String
  status     StatusAssinatura @default(ATIVA)

  inicioEm          DateTime
  expiraEm          DateTime?
  proximaCobrancaEm DateTime?
  canceladaEm       DateTime?
  motivoCancelamento String?
  suspensaEm        DateTime?
  retomadaEm        DateTime?

  periodicidade       Periodicidade @default(MENSAL)
  valorAtual          Decimal?      @db.Decimal(10, 2)
  moeda               String        @default("BRL")
  gatewayClienteId    String?
  gatewayAssinaturaId String?

  torcedor Torcedor         @relation(fields: [torcedorId], references: [id], onDelete: Restrict)
  plano    Plano            @relation(fields: [planoId], references: [id], onDelete: Restrict)
  faturas  Fatura[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([torcedorId, status])
  @@index([planoId])
  @@index([status, proximaCobrancaEm])
  @@map("assinaturas")
}

model Fatura {
  id           String       @id @default(uuid())
  assinaturaId String
  competencia  String
  valor        Decimal      @db.Decimal(10, 2)
  status       StatusFatura @default(ABERTA)
  vencimentoEm DateTime
  pagoEm       DateTime?
  referencia   String?      @unique
  metodo       MetodoPagamento?

  assinatura      Assinatura       @relation(fields: [assinaturaId], references: [id])
  pagamentosSocio PagamentoSocio[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([assinaturaId, status, vencimentoEm])
  @@map("faturas")
}


model PagamentoSocio {
  id             String               @id @default(uuid())
  torcedorId     String
  faturaId       String?
  valor          Decimal              @db.Decimal(10, 2)
  status         StatusPagamentoSocio @default(PENDENTE)
  dataVencimento DateTime
  pagoEm         DateTime?
  referencia     String?              @unique
  metodo         MetodoPagamento
  descricao      String?
  gatewayPaymentId String?

  torcedor Torcedor @relation(fields: [torcedorId], references: [id])
  fatura   Fatura?  @relation(fields: [faturaId], references: [id], onDelete: SetNull)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([torcedorId])
  @@index([faturaId])
  @@index([status, dataVencimento])
  @@map("pagamentos_socio")
}

// JOGOS E SETORES

model Jogo {
  id        String   @id @default(uuid())
  nome      String
  data      DateTime
  local     String   @default("Bento Freitas")
  descricao String?

  setores JogoSetor[]
  lotes   Lote[]

  criadoPorId     String?
  atualizadoPorId String?
  criadoPor       Admin?  @relation("JogoCriadoPor", fields: [criadoPorId], references: [id])
  atualizadoPor   Admin?  @relation("JogoAtualizadoPor", fields: [atualizadoPorId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([data])
  @@map("jogos")
}

model Setor {
  id   String    @id @default(uuid())
  slug String    @unique
  nome String    @unique
  tipo TipoSetor @default(ARQUIBANCADA)

  jogos JogoSetor[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("setores")
}

model JogoSetor {
  id         String  @id @default(uuid())
  jogoId     String
  setorId    String
  capacidade Int
  aberto     Boolean @default(true)

  jogo  Jogo   @relation(fields: [jogoId], references: [id])
  setor Setor  @relation(fields: [setorId], references: [id])
  lotes Lote[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([jogoId, setorId])
  @@index([jogoId])
  @@map("jogos_setores")
}

// LOTES, PEDIDOS E INGRESSOS

model Lote {
  id            String    @id @default(uuid())
  jogoSetorId   String
  jogoId        String    
  nome          String
  tipo          TipoLote  @default(INTEIRA)
  quantidade    Int?
  precoUnitario Decimal   @db.Decimal(10, 2)
  inicioVendas  DateTime?
  fimVendas     DateTime?
  limitePorCPF  Int?

  jogoSetor   JogoSetor    @relation(fields: [jogoSetorId], references: [id])
  jogo        Jogo         @relation(fields: [jogoId], references: [id])
  itensPedido ItemPedido[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([jogoSetorId])
  @@index([jogoId])
  @@map("lotes")
}

model Pedido {
  id         String       @id @default(uuid())
  torcedorId String
  status     StatusPedido @default(PENDENTE)
  expiraEm   DateTime?    

  torcedor  Torcedor           @relation(fields: [torcedorId], references: [id])
  itens     ItemPedido[]
  pagamento PagamentoIngresso?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([torcedorId])
  @@index([status, expiraEm])
  @@map("pedidos")
}

model ItemPedido {
  id            String  @id @default(uuid())
  pedidoId      String
  loteId        String
  valorUnitario Decimal @db.Decimal(10, 2)

  pedido   Pedido    @relation(fields: [pedidoId], references: [id])
  lote     Lote      @relation(fields: [loteId], references: [id])
  ingresso Ingresso?

  @@index([pedidoId])
  @@index([loteId])
  @@map("itens_pedido")
}

model PagamentoIngresso {
  id         String                  @id @default(uuid())
  pedidoId   String                  @unique
  total      Decimal                 @db.Decimal(10, 2)
  status     StatusPagamentoIngresso @default(AGUARDANDO)
  provider   String                  
  externalId String?                

  pedido Pedido @relation(fields: [pedidoId], references: [id])

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("pagamentos_ingresso")
}

model Ingresso {
  id           String         @id @default(uuid())
  itemPedidoId String         @unique
  qrCode       String         @unique
  status       StatusIngresso @default(VALIDO)
  usadoEm      DateTime?

  itemPedido ItemPedido @relation(fields: [itemPedidoId], references: [id])
  checkins   Checkin[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([status])
  @@map("ingressos")
}

model Checkin {
  id         String   @id @default(uuid())
  ingressoId String
  feitoEm    DateTime @default(now())
  feitoPor   String?
  local      String?

  ingresso Ingresso @relation(fields: [ingressoId], references: [id])

  @@index([ingressoId])
  @@map("checkins")
}